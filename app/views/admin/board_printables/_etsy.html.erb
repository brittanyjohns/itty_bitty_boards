<%# Etsy. This creates a DRAFT and only a draft — there is no code path in the
    app that activates a listing. Going live stays a deliberate click in the
    Etsy seller UI, after a human has checked the category, the photos, and the
    return policy.

    A printable can carry SEVERAL listings — a standalone and a bundle, say —
    so publishing, detaching and sending a video are per-listing and live on
    each card below. What is refused is publishing the same ROW twice.

    Two states are tracked separately and must not be collapsed:

      attached?             — that row has a draft RIGHT NOW. Gates publishing
                              it, and is what "Detach" clears.
      etsy_ever_published?  — a draft was made from this printable at some
                              point. Gates marketplace PROTECTION, and is never
                              cleared, because detaching doesn't un-print the
                              paper already carrying these boards' QR codes. %>
<div class="admin-card border rounded-xl p-5 mb-6">
  <h2 class="text-sm font-medium text-t1 mb-1">Etsy</h2>
  <p class="text-[11px] text-t3 mb-4">
    Creates a <strong>draft</strong> listing with the copy above, the images, and the PDFs.
    Nothing goes live until you publish it in Etsy yourself.
  </p>

  <% if @printable.etsy_error.present? %>
    <div class="admin-flash-err border rounded-lg px-4 py-3 text-sm mb-4">
      <%= @printable.etsy_error %>
    </div>
  <% end %>

  <%# Every listing this printable has ever had, superseded ones included — the
      record the old scalar columns could not keep. %>
  <% if @etsy_listings.present? %>
    <div class="space-y-3 mb-4">
      <%= render partial: "admin/board_printables/etsy_listing",
                 collection: @etsy_listings, as: :etsy_listing %>
    </div>
  <% end %>

  <% if !@etsy_configured %>
    <p class="text-xs text-t3">
      Etsy isn't configured. Set <code>ETSY_KEYSTRING</code>, <code>ETSY_SHARED_SECRET</code>,
      <code>ETSY_OAUTH_CLIENT_ID</code> and <code>ETSY_SHOP_ID</code>, then seed this app's own
      refresh token with <code>rake etsy:seed_refresh_token</code>.
    </p>
  <% else %>
    <%# Adding a listing touches nothing external — it allocates a row to edit
        and publish later. That ordering is the point: the row is the token a
        publish claims exactly once, so a double-click cannot make two drafts. %>
    <%= form_with url: admin_dashboard_board_printable_listings_path(@printable),
                  method: :post, class: "flex flex-wrap items-end gap-3 pt-3 border-t",
                  style: "border-color: var(--border);", data: { turbo: false } do |f| %>
      <div>
        <label class="block text-[11px] text-t2 mb-1">Kind</label>
        <%= select_tag "board_printable_listing[purpose]",
              options_for_select(BoardPrintableListing::PURPOSES.map { |p| [p.humanize, p] }),
              class: "text-xs rounded admin-card-alt px-2 py-2" %>
      </div>
      <div>
        <label class="block text-[11px] text-t2 mb-1">Label (optional)</label>
        <%= text_field_tag "board_printable_listing[label]", nil, placeholder: "holiday bundle",
              class: "text-xs rounded admin-card-alt px-2 py-2" %>
      </div>
      <%= submit_tag @etsy_listings.any? ? "Add another listing" : "Add a listing",
            class: "text-xs font-medium px-3 py-2 rounded bg-indigo-600 hover:bg-indigo-500 text-white cursor-pointer",
            data: { turbo_confirm: create_listing_confirm(@printable) } %>
    <% end %>
  <% end %>

  <%# Protection is keyed on having EVER been published, so this block sits
      outside the branch above — a detached printable still freezes its boards,
      and hiding the release control there would strand it. Every board in the
      printed tree is covered, not just the root: each interior page carries its
      own QR. %>
  <% if @printable.etsy_ever_published? %>
    <div class="mt-4 pt-4 border-t border-white/10">
      <% if @printable.protection_waived? %>
        <p class="text-[11px] text-t3">
          Protection released <%= @printable.protection_waived_at.strftime("%b %-d, %Y") %><%=
            " by #{@printable.protection_waived_by.email}" if @printable.protection_waived_by %>.
          These boards can be deleted, renamed and unpublished again.
          <%= "Reason: #{@printable.protection_waived_reason}" if @printable.protection_waived_reason.present? %>
        </p>
      <% else %>
        <div class="flex items-start justify-between gap-4">
          <p class="text-[11px] text-t3">
            <span class="inline-block px-1.5 py-0.5 rounded <%= marketplace_protection_badge %> font-medium mr-1">Protected</span>
            <%= pluralize(@printable.protected_board_ids.size, "board") %> in this printable can't be deleted,
            renamed or unpublished — printed copies carry a QR pointing at each page.
          </p>
          <%= button_to "Release protection", waive_protection_admin_dashboard_board_printable_path(@printable),
                method: :post,
                class: "shrink-0 text-xs font-medium px-3 py-2 rounded admin-card-alt text-t2 hover:text-t1 cursor-pointer",
                form: { data: { turbo_confirm: waive_protection_confirm(@printable) } } %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
