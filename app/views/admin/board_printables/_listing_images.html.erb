<%# The gallery images Etsy needs. Etsy will create a listing with none, but
    won't let it go live without one — so an empty gallery here is a draft you
    can't finish. Publishing renders them automatically if they're missing;
    this card exists to preview and re-render them. %>
<div class="admin-card border rounded-xl p-5 mb-6">
  <div class="flex items-baseline justify-between mb-1">
    <h2 class="text-sm font-medium text-t1">Listing images</h2>
    <%= button_to "Regenerate", regenerate_listing_images_admin_dashboard_board_printable_path(@printable),
          method: :post,
          class: "text-xs font-medium px-3 py-1.5 rounded border admin-input cursor-pointer text-t1" %>
  </div>
  <p class="text-[11px] text-t3 mb-4">
    Ten square slides — Etsy's cap exactly — built from this board's own pages.
    Four are photoreal mockups: the printed sheet staged in two rooms and the
    board running in the app on two tablets, each warped onto a calibrated
    placeholder rather than pasted flat. Scenes and colourway are picked from
    the board, so no two listings look alike. Nothing here needs adding in Etsy
    by hand.
  </p>

  <%# A printable rendered before the current gallery still has images, so "has
      any" would look fine while the set is an older one. Publishing re-renders
      on its own, but the admin should know before clicking. %>
  <% if @printable.listing_images? && !@printable.listing_images_current? %>
    <p class="text-xs mb-4 px-3 py-2 rounded border"
       style="border-color: var(--border); color: var(--t1);">
      These were rendered with an older gallery. Regenerate before publishing.
    </p>
  <% end %>

  <% images = @printable.listing_images_view %>
  <% if images.any? %>
    <div class="flex flex-wrap gap-4">
      <% images.each_with_index do |image, index| %>
        <div>
          <%= link_to image[:url], target: "_blank", rel: "noopener" do %>
            <%# object-contain, not cover: the slides are square and cropping one
                in the preview hides exactly the edge problems worth catching. %>
            <%= image_tag image[:url], alt: image[:variant],
                  class: "w-40 h-40 object-contain rounded-lg border bg-white", style: "border-color: var(--border);" %>
          <% end %>
          <p class="text-[11px] text-t3 mt-1">
            Rank <%= index + 1 %> · <%= image[:variant].humanize %>
          </p>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="text-xs text-t3">
      None rendered yet. They'll be generated automatically when you create the Etsy draft.
    </p>
  <% end %>
</div>
