<%# SpeakAnyWay logo header for transactional emails. Loads the logo over HTTPS
   from the URL ApplicationMailer resolves — never an inline (cid) attachment,
   which mail clients list in the attachment strip even when the HTML references
   it. Guarded so templates without @logo (e.g. Devise mailers) render nothing. %>
<% if @logo %>
  <div style="text-align:center; padding:4px 0 20px 0;">
    <a href="https://app.speakanyway.com" target="_blank" rel="noopener" style="text-decoration:none; border:0;">
      <%= image_tag @logo.url, alt: "SpeakAnyWay", width: 48, height: 48, style: "width:48px; height:48px; display:inline-block; border:0; outline:none;" %>
    </a>
  </div>
<% end %>
