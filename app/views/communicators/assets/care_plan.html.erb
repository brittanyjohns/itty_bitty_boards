<%# The communicator care plan — a flowing, multi-page Letter document.
    Rendered by Communicators::GenerateCarePlan under layouts/pdf_care_plan.

    Locals arrive as @-ivars via ApplicationController.render(assigns:), the
    same convention as the safety ID card and device tag.

    No cover page, deliberately: this is a 2-3 sheet document that lives in a
    backpack or a school office folder, and a cover would burn one of them.

    In the :full variant the emergency block comes FIRST, before the care
    sections — it is what someone reaches for in a hurry, and it should not be
    on page 2. %>

<%# Painted once per sheet by Chrome, not part of the flow — see .page-frame
    in the layout. .sheet-content carries the padding that keeps page-1
    content off the frame; every later page gets its clearance from a
    .card's own padding-top instead (also in the layout). %>
<div class="page-frame"></div>

<div class="sheet-content">
  <div class="topbar"></div>

  <header class="identity">
    <%= render "communicators/assets/care_plan_identity" %>
  </header>

  <% if @emergency %>
    <%= render "communicators/assets/care_plan_glance" %>
    <%= render "communicators/assets/care_plan_emergency" %>
  <% end %>

  <% if @care_sections.any? %>
    <%# The heading sits above the loop, outside .cols. It can no longer strand
        at the foot of a page: what follows it is a two-column flow, not one
        tall element. %>
    <div class="care-heading"><%= t("care.document.care_heading") %></div>

    <div class="cols">
      <% @care_sections.each do |section| %>
        <%= render "communicators/assets/care_plan_card", section: section %>
      <% end %>
    </div>
  <% end %>

  <div class="footnote">
    <span>
      <%= t("care.document.live_page") %>
      <% if @emergency %>
        <%= t("care.document.confidential") %>
      <% end %>
    </span>
    <% if @logo.present? %>
      <img class="mark" src="data:image/png;base64,<%= @logo %>" alt="" />
    <% end %>
  </div>
</div>
