<%# The emergency block: a white card with a red left rail (the gradient-fill
    red box is gone). Shared by the sheet and half sizes. Reads @emergency_fields
    / @blank_emergency_fields_note / @emergency_contacts directly, same as the
    glance partial.

    The muted "not provided" line arrives pre-joined from
    CarePlanDocument#blank_emergency_fields_note — the Safety ID card prints the
    same sentence, so the wording lives in one place rather than in each
    template. %>
<section class="emergency">
  <div class="sec-head">
    <h2><%= t("care.document.emergency.heading") %></h2><span class="line"></span>
  </div>

  <div class="egrid">
    <% @emergency_fields.each do |field| %>
      <%# Allergies renders in the glance strip only. Free-text notes run long
          enough to want the full width. %>
      <% next if field.key == "allergies" %>
      <div class="f<%= " wide" if field.key == "emergency_notes" %>">
        <span class="k"><%= field.label %></span><%= field.values.first %>
      </div>
    <% end %>

    <% if @blank_emergency_fields_note.present? %>
      <div class="not-provided"><%= @blank_emergency_fields_note %></div>
    <% end %>
  </div>

  <div class="contacts">
    <% if @emergency_contacts.any? %>
      <% @emergency_contacts.each do |contact| %>
        <div class="contact">
          <span class="name"><%= contact["name"].presence || t("care.document.emergency.relationship_unknown") %></span><% if contact["relationship"].present? %> <span class="rel">· <%= contact["relationship"] %></span><% end %>
          <span class="phone"><%= contact["phone"] %></span>
        </div>
      <% end %>
    <% else %>
      <div class="contact muted"><%= t("care.document.emergency.no_contacts") %></div>
    <% end %>
  </div>
</section>
