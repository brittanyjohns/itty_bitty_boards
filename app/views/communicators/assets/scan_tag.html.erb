<div style="
  width:800px;
  height:800px;
  padding:26px;
  background:
    radial-gradient(circle at top left, rgba(168, 85, 247, 0.18) 0%, rgba(168, 85, 247, 0) 30%),
    radial-gradient(circle at bottom right, rgba(59, 130, 246, 0.18) 0%, rgba(59, 130, 246, 0) 32%),
    linear-gradient(135deg, #f8fbff 0%, #fdfaff 50%, #f7fbff 100%);
  color:#1e293b;
  position:relative;
  overflow:hidden;
">
  <div style="
    position:absolute;
    top:-70px;
    right:-50px;
    width:220px;
    height:220px;
    border-radius:999px;
    background:rgba(139, 92, 246, 0.08);
  "></div>

  <div style="
    position:absolute;
    bottom:-80px;
    left:-60px;
    width:240px;
    height:240px;
    border-radius:999px;
    background:rgba(59, 130, 246, 0.08);
  "></div>

  <div style="
    height:100%;
    border-radius:34px;
    background:linear-gradient(180deg, rgba(255,255,255,0.98) 0%, rgba(248,250,252,0.98) 100%);
    border:1px solid rgba(226,232,240,0.9);
    box-shadow:
      0 22px 60px rgba(15, 23, 42, 0.10),
      0 8px 24px rgba(139, 92, 246, 0.08);
    padding:34px 34px 26px 34px;
    display:flex;
    flex-direction:column;
    position:relative;
    overflow:hidden;
  ">
    <div style="
      position:absolute;
      top:0;
      left:0;
      right:0;
      height:10px;
      background:linear-gradient(90deg, #8b5cf6 0%, #6366f1 45%, #3b82f6 100%);
    "></div>

    <!-- QR + optional line. Centered as one block, so a tag with no line
         reads as deliberate rather than as a card with a hole in it. -->
    <div style="
      flex:1;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      min-height:0;
      padding-top:10px;
    ">
      <% if @qr_data_url.present? %>
        <div style="
          padding:18px;
          background:#ffffff;
          border-radius:26px;
          border:1px solid #e2e8f0;
          box-shadow:0 10px 24px rgba(15, 23, 42, 0.08);
        ">
          <img
            src="<%= @qr_data_url %>"
            style="
              width:420px;
              height:420px;
              display:block;
            "
          />
        </div>
      <% else %>
        <div style="
          width:456px;
          height:456px;
          border-radius:26px;
          background:linear-gradient(135deg, #f1f5f9 0%, #e2e8f0 100%);
          border:1px solid #e2e8f0;
        "></div>
      <% end %>

      <% if @note.present? %>
        <div style="
          margin-top:30px;
          font-size:32px;
          line-height:1.24;
          font-weight:700;
          color:#0f172a;
          max-width:600px;
          word-break:break-word;
        ">
          <%= @note %>
        </div>
      <% end %>
    </div>

    <!-- Footer -->
    <div style="
      display:flex;
      align-items:center;
      justify-content:center;
      gap:10px;
      margin-top:18px;
      padding-top:4px;
    ">
      <% if @logo.present? %>
        <img
          alt="SpeakAnyWay Logo"
          src="data:image/png;base64,<%= @logo %>"
          style="
            height:26px;
            width:auto;
            object-fit:contain;
            display:block;
          "
        />
      <% end %>

      <div style="
        font-size:15px;
        color:#94a3b8;
        font-weight:700;
        letter-spacing:0.10em;
        text-transform:uppercase;
      ">
        SpeakAnyWay
      </div>
    </div>
  </div>
</div>
