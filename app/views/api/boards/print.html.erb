<%# Three header states, from @header_mode (Boards::RenderAssetData) — never a
    pair of booleans. The QR lives INSIDE this block, so "hide the header" and
    "keep the code" are the same decision and have to be made in one place.

    qr_only is what the trim-ready PDF prints: buyers cut the title band off to
    laminate the board, and the code has to survive that cut.

    Falls back to @hide_header so a caller that renders this template with its
    own assigns — rather than through RenderAssetData — still gets the old
    all-or-nothing behaviour instead of an unstyled full header. %>
<% header_mode = @header_mode.presence || (@hide_header ? Boards::RenderAssetData::HEADER_NONE : Boards::RenderAssetData::HEADER_FULL) %>

<%# Tile art falls back to the label-drawn placeholder in two situations, and
    both land here so the swap looks identical either way.

    onerror covers a picture that FAILS (404 on an S3 key that was never
    written, a dead remote URL). @image_load_deadline_ms covers a picture that
    HANGS — the request that neither resolves nor errors, so onerror never
    fires. Grover waits on networkidle0, so one hanging tile means the render
    never returns at all and the board ends up with no snapshot; setting the
    src to the data-URL placeholder cancels the pending request and lets the
    network settle.

    The deadline is opt-in (Boards::RenderAssetData defaults it to nil) because
    only the auto preview wants it. Printable PDFs are a paid artifact and must
    keep waiting for the real symbol rather than shipping a placeholder. %>
<% if @image_load_deadline_ms.to_i > 0 %>
  <script>
    window.__tileImageDeadlineMs = <%= @image_load_deadline_ms.to_i %>;
  </script>
<% end %>
<script>
  function swapTileToPlaceholder(img) {
    if (img.dataset.placeholderApplied) return;

    var placeholder = img.getAttribute("data-placeholder-src");
    if (!placeholder) return;

    img.dataset.placeholderApplied = "1";
    img.onerror = null;
    img.src = placeholder;
    img.classList.add("tile-placeholder-image");

    // The placeholder already draws the word, so the caption underneath would
    // just repeat it.
    var tile = img.closest(".tile");
    var label = tile && tile.querySelector(".label");
    if (label) label.style.display = "none";
  }

  if (window.__tileImageDeadlineMs) {
    window.setTimeout(function () {
      var images = document.querySelectorAll("img[data-tile-image]");
      for (var i = 0; i < images.length; i++) {
        var img = images[i];
        // naturalWidth guards the decoded-but-broken case: `complete` is true
        // for an image that finished loading nothing.
        if (!img.complete || img.naturalWidth === 0) swapTileToPlaceholder(img);
      }
    }, window.__tileImageDeadlineMs);
  }
</script>
<% if header_mode == Boards::RenderAssetData::HEADER_QR_ONLY %>
  <div class="header header-qr-only">
    <% if @qr_data_url.present? %>
      <div class="qr-small">
        <img src="<%= @qr_data_url %>" alt="QR code">
      </div>
    <% end %>
  </div>
<% elsif header_mode != Boards::RenderAssetData::HEADER_NONE %>
  <div class="header">
    <div class="header-inner">
      <div class="logo">
        <% if @logo.present? %>
          <img alt="SpeakAnyWay Logo" src="data:image/png;base64,<%= @logo %>">
        <% end %>
      </div>

      <div class="header-copy">
        <p class="board-title">
          <strong><%= @board_title %></strong>
        </p>

        <p class="board-subtitle">
          Created with SpeakAnyWay AAC
        </p>
        <% if @board_expires_at %>
          <div class="unclaimed-message">
          <p class="board-subtitle" style="color: #ff0000; font-weight: bold;">
            This board is unclaimed and will expire on <%= @board_expires_at.strftime("%B %d, %Y  at %l:%M %p") %> if not claimed. Please claim this board to keep it and edit it online.
          </p>
          </div>
        <% end %>

        <% if @qr_data_url.present? %>
          <div class="board-link">
            Scan the code or visit
            <a href="<%= @qr_target_url %>" target="_blank" rel="noopener noreferrer">
              <%= @qr_target_url %>
            </a>
            for the full interactive version of this board.
          </div>
        <% end %>
      </div>

      <% if @qr_data_url.present? %>
        <div class="qr-small">
          <img src="<%= @qr_data_url %>" alt="QR code">
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<div class="board-wrap">
  <div
    class="board-sizer"
    style="width:<%= @board_render_width_mm %>mm; height:<%= @board_render_height_mm %>mm;"
  >
    <div
      class="board-grid"
      style="
        grid-template-columns: repeat(<%= @columns %>, 1fr);
        grid-template-rows: repeat(<%= @rows %>, 1fr);
      "
    >
      <% @tiles.each do |t| %>
        <% bg_color = @hide_colors ? "" : (t["bg_color"] || "black") %>
        <% border_color = @hide_colors ? "" : (t["border_color"] || "black") %>
        <% border_width = t["border_width"] || 0 %>
        <% border_radius = t["border_radius"] || 0 %>
        <% if t["hide_label"] %>
          <% label_hidden = true %>
        <% else %>
          <% label_hidden = false %>
        <% end %>
        <% has_image = t["image_url"].present? %>
        <% col_start = t["x"].to_i + 1 %>
        <% row_start = t["y"].to_i + 1 %>
        <% col_span = t["w"].to_i %>
        <% row_span = t["h"].to_i %>

        <div
          class="tile"
          style="
            background-color:<%= bg_color.presence || "#ffffff" %>;
            grid-column:<%= col_start %> / span <%= col_span %>;
            grid-row:<%= row_start %> / span <%= row_span %>;
            border-color:<%= border_color.presence || "#000000" %>;
            border-width:<%= border_width %>px;
            border-radius:<%= border_radius %>px;
          "

        >
          <% placeholder_src = generate_placeholder_image(t["label"]) %>
          <div class="tile-media">
            <% if has_image %>
              <img
                src="<%= t["image_url"] %>"
                alt="<%= t["label"] %>"
                data-tile-image
                data-placeholder-src="<%= placeholder_src %>"
                onerror="swapTileToPlaceholder(this);"
              >
            <% else %>
              <img
                src="<%= placeholder_src %>"
                alt="<%= t["label"] %>"
                class="tile-placeholder-image"
              >
            <% end %>
          </div>

          <%# Label-only tiles (no picture) already render the label as the
              placeholder image, so skip the redundant caption underneath. %>
          <% if has_image && !label_hidden %>
            <div
            class="label <%= bg_color %>"
            style="
              font-weight:<%= @hide_colors ? "normal" : "bold" %>;
              background-color:<%= bg_color.presence || "#f7f7f7" %>;
            ">
            <%= t["label"] %>
          </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
</div>