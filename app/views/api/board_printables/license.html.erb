      </li>
      <li>
        <span class="mark no"><svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" /></svg></span>
        <span>Don't modify it and republish it as your own work.</span>
      </li>
    </ul>

    <div class="license-foot">
