<%# Filled line-art icons for the feature lists. Inline SVG, never emoji — see
    rail 2 in layouts/listing_image_styled.html.erb. Unknown names render
    nothing rather than a broken glyph. %>
<% case name %>
<% when "boards" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="8" height="8" rx="2"/><rect x="13" y="3" width="8" height="8" rx="2"/><rect x="3" y="13" width="8" height="8" rx="2"/><rect x="13" y="13" width="8" height="8" rx="2"/></svg>
<% when "words" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3C6.5 3 2 6.6 2 11c0 2.4 1.3 4.5 3.4 6L4.5 21l4.4-2.3c1 .2 2 .3 3.1.3 5.5 0 10-3.6 10-8s-4.5-8-10-8z"/></svg>
<% when "printer" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 2h10v5H7z"/><path fill-rule="evenodd" d="M5 8h14a3 3 0 0 1 3 3v6h-4v5H6v-5H2v-6a3 3 0 0 1 3-3zm3 7v5h8v-5z"/></svg>
<% when "devices" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M2 5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3h-2V5H4v13h7v2H4a2 2 0 0 1-2-2z"/><path fill-rule="evenodd" d="M14 9h6a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-9a2 2 0 0 1 2-2zm0 2v8h6v-8z"/></svg>
<% when "sound" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 9h4l5-4v14l-5-4H3z"/><path d="M15.5 8.5a5 5 0 0 1 0 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/><path d="M18.5 5.5a9 9 0 0 1 0 13" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" fill="none"/></svg>
<% when "file" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M6 2h8l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zm1 10v2h10v-2zm0 4v2h10v-2z"/></svg>
<% when "home" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2 11h3v10h5v-6h4v6h5V11h3z"/></svg>
<% when "drop" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.5c-.3 0-.6.2-.8.4C8.6 6.3 5 11.2 5 14.8 5 18.8 8.1 22 12 22s7-3.2 7-7.2c0-3.6-3.6-8.5-6.2-11.9-.2-.2-.5-.4-.8-.4z"/></svg>
<% when "palette" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2C6.5 2 2 6.2 2 11.5 2 16.2 5.8 20 10.5 20h1.2c1 0 1.8-.8 1.8-1.8 0-.5-.2-.9-.5-1.2-.3-.3-.5-.8-.5-1.2 0-1 .8-1.8 1.8-1.8H16c3.3 0 6-2.7 6-6C22 4.6 17.5 2 12 2zM6.5 12a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3-4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm5 0a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3zm3 4a1.5 1.5 0 1 1 0-3 1.5 1.5 0 0 1 0 3z"/></svg>
<% when "shield" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M12 2 4 5v6c0 5 3.4 9.6 8 11 4.6-1.4 8-6 8-11V5zm-1.2 13.6-3.5-3.5 1.4-1.4 2.1 2.1 4.6-4.6 1.4 1.4z"/></svg>
<% when "download" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11 3h2v9.2l3.3-3.3 1.4 1.4L12 16l-5.7-5.7 1.4-1.4 3.3 3.3z"/><path d="M4 15h2v4h12v-4h2v6H4z"/></svg>
<% when "qr" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path fill-rule="evenodd" d="M3 3h8v8H3zm2 2v4h4V5zm8-2h8v8h-8zm2 2v4h4V5zM3 13h8v8H3zm2 2v4h4v-4z"/><path d="M6 6h2v2H6zm10 0h2v2h-2zM6 16h2v2H6zm7-3h2v2h-2zm4 0h4v2h-4zm-4 4h2v4h-2zm4 0h2v2h-2zm2 2h2v2h-2zm-4 0h2v2h-2z"/></svg>
<% when "check" %>
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9.5 16.2 5.3 12l-1.8 1.8 6 6L21 8.3l-1.8-1.8z"/></svg>
<% end %>
