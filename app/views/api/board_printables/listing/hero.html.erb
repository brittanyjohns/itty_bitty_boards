<%# The listing's first image, and the only one most buyers ever see — it is the
    thumbnail competing in an Etsy search grid.

    Shows the real board pages on a room background rather than a mocked-up
    product, so what sells the listing is the thing being sold. The pages are
    never cropped (see .paper in the layout): a board page has genuine margins
    and how much of the sheet it fills depends on the board's shape.

    Two things rotate per listing so a shop page doesn't read as one product
    photographed five times: the room scene (hashed by BrandAssets) and the
    palette the ribbon, badge and footer band draw from (hashed separately by
    Palette, so the two don't move in lockstep). %>
<div class="slide has-ribbon">
  <% if @background %>
    <img class="bg-image" src="<%= @background %>" alt="" />
    <div class="bg-scrim"></div>
  <% end %>

  <div class="instant-ribbon"><%= Printables::SlideCopy.instant_download_banner %></div>

  <% if @logo %>
    <img class="logo-corner" src="<%= @logo %>" alt="SpeakAnyWay" />
  <% end %>

  <div class="slide-stack has-ribbon has-footer">
    <div class="title-banner <%= "small" if @title.to_s.length > 26 %>"><%= @title %></div>
    <div class="headline-callout"><%= @headline %></div>

    <%# The one claim a competitor's printable can't match, given its own object
        rather than a line in the footer list. Inline SVG speaker, never an
        emoji — see rail 2 in the layout. %>
    <div class="audio-badge">
      <svg viewBox="0 0 48 48" aria-hidden="true">
        <path d="M8 18h8l12-9v30l-12-9H8z" />
        <path d="M34 18c3 3.5 3 8.5 0 12" />
        <path d="M40 13c5 6 5 16 0 22" />
      </svg>
      <span><%= Printables::SlideCopy.audio_companion_badge %></span>
    </div>

    <%# One page gets the stage to itself; a set fans so the count is legible
        before a word of the description is read.

        The fan's geometry is written inline from Boards::Printables::HeroFan
        rather than living in the layout, so the CSS never has to know how many
        cards there are — see the .hero-stage.fan comment there. %>
    <div class="hero-stage stretch <%= @fan ? "fan" : "single" %> <%= "has-sticker" if @count_badge %>"
         <%= "style=\"--fan-w: #{@fan.css_width}; --fan-overlap: #{@fan.css_overlap};\"".html_safe if @fan %>>
      <%# The sticker, over the pile rather than in the column: at Etsy
          thumbnail size a headline is a smudge and a numeral is not. %>
      <% if @count_badge %>
        <div class="count-sticker">
          <strong><%= @count_badge[:count] %></strong>
          <span><%= @count_badge[:label] %></span>
        </div>
      <% end %>

      <% if @thumbnails.any? %>
        <% @thumbnails.each_with_index do |tile, index| %>
          <% card = @fan&.cards&.[](index) %>
          <div class="paper"
               style="aspect-ratio: <%= tile[:width] %> / <%= tile[:height] %>;<%= " --rot: #{card.rotation_deg}deg; --z: #{card.z_index};" if card %>">
            <img src="<%= tile[:data_uri] %>" alt="<%= tile[:label] %>" />
          </div>
        <% end %>
      <% else %>
        <div class="hero-empty"><%= @headline %></div>
      <% end %>
    </div>

    <% if @count_badge %>
      <div class="variant-strip"><%= @count_badge[:detail] %></div>
    <% end %>
  </div>

  <div class="footer-strip">
    <div class="footer-bullets">
      <div class="footer-title"><%= Printables::SlideCopy.audio_companion_headline %></div>
      <ul class="bullets">
        <% Printables::SlideCopy.hero_footer_bullets.each do |bullet| %>
          <li><%= bullet %></li>
        <% end %>
      </ul>
    </div>

    <% if @qr_data_url %>
      <div class="footer-qr">
        <img src="<%= @qr_data_url %>" alt="Scan to open this board" />
        <span class="qr-caption">Scan to hear it</span>
      </div>
    <% end %>

    <div class="site-mark"><%= Printables::SlideCopy.site_mark %></div>
  </div>
</div>
